#!/usr/bin/env bash
set -euo pipefail

# Android-folder Gradle wrapper shim for CI.
# Delegate to workspace-level gradlew if present; otherwise no-op.

WRAPPER="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/gradlew"

if [[ -f "${WRAPPER}" ]]; then
  exec bash "${WRAPPER}" "$@"
fi

echo "No workspace Gradle wrapper found; skipping Gradle task: ${*:-<none>}"
exit 0
